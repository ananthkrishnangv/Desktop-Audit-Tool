<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DesktopAuditTool_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DesktopAuditTool_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Enterprise Desktop Security Audit Tool"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Enterprise Desktop Security Audit Tool">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />

        <!-- Professional Semi-Transparent Footer Bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,5"
                MinHeight="28">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Left: Air-gap status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Opacity="0.55">
                    <FontIcon Glyph="&#xE72E;" FontSize="11" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="100% Air-Gapped &amp; Offline" FontSize="11" />
                    <TextBlock Text="•" FontSize="11" />
                    <TextBlock Text="DPDP 2023 &amp; CERT-In Verified" FontSize="11" />
                </StackPanel>

                <!-- Center: Small Semi-Transparent Tag -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,3"
                        Opacity="0.65">
                    <TextBlock Text="Made by ICTD CSIR-SERC for CSIR with ❤️"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>

                <!-- Right: Version status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Opacity="0.55">
                    <TextBlock Text="v1.0.0 Enterprise" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
