<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DesktopAuditTool_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DesktopAuditTool_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Action & Status Bar -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png" Width="36" Height="36" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Enterprise Desktop Security Audit &amp; Threat Intel" FontWeight="Bold" FontSize="16" />
                        <TextBlock x:Name="TxtSystemIdentity" Text="Connecting to host telemetry..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing x:Name="AuditProgressRing" IsActive="False" Width="20" Height="20" />
                    <Button x:Name="BtnRunAudit" Style="{ThemeResource AccentButtonStyle}" Click="BtnRunAudit_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="Run Audit On-Demand" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnToggleFullScreen" ToolTipService.ToolTip="Toggle Full Screen (F11)" Click="BtnToggleFullScreen_Click">
                        <FontIcon Glyph="&#xE740;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Notification InfoBar -->
        <InfoBar x:Name="StatusInfoBar" Grid.Row="0" VerticalAlignment="Bottom" IsOpen="False" Severity="Informational" Margin="16,0,16,8" Canvas.ZIndex="10" />

        <!-- WinUI 3 NavigationView -->
        <NavigationView x:Name="NavView" Grid.Row="1" IsSettingsVisible="False" PaneDisplayMode="Left" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemDashboard" Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemFindings" Content="Findings &amp; CVEs" Tag="findings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemModules" Content="22 Audit Modules" Tag="modules">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemCompliance" Content="Compliance Scorecards" Tag="compliance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemDlp" Content="Data Protection (DLP)" Tag="dlp">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemThreats" Content="AI Threat Intelligence" Tag="threats">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemRemediation" Content="Automated Remediation" Tag="remediation">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemCopilot" Content="AI Security Copilot" Tag="copilot">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemExports" Content="Export Reports" Tag="exports">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Navigation Content Frame/Panels -->
            <ScrollViewer Padding="24">
                <Grid>
                    <!-- VIEW 1: DASHBOARD -->
                    <StackPanel x:Name="ViewDashboard" Spacing="20" Visibility="Visible">
                        <!-- STATUTORY COMPLIANCE & AIR-GAP SEALS RIBBON -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid RowDefinitions="Auto, Auto" RowSpacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" Foreground="#38BDF8" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    <TextBlock Text="STATUTORY SEALS &amp; AIR-GAP COMPLIANCE ASSURANCE:" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- DPDP 2023 -->
                                        <Border Background="#0F2D1F" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#10B981" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="DPDP ACT 2023" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                            </StackPanel>
                                        </Border>
                                        <!-- CERT-In -->
                                        <Border Background="#1E2238" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#818CF8" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="CERT-In COMPLIANT" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC" />
                                            </StackPanel>
                                        </Border>
                                        <!-- DoD DISA STIG -->
                                        <Border Background="#2E2412" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FBBF24" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="DoD DISA STIG" FontSize="10" FontWeight="Bold" Foreground="#FDE68A" />
                                            </StackPanel>
                                        </Border>
                                        <!-- CMMC 2.0 -->
                                        <Border Background="#083344" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#22D3EE" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="CMMC 2.0 LEVEL 2" FontSize="10" FontWeight="Bold" Foreground="#67E8F9" />
                                            </StackPanel>
                                        </Border>
                                        <!-- PCI-DSS v4.0 -->
                                        <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#34D399" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="PCI-DSS v4.0" FontSize="10" FontWeight="Bold" Foreground="#A7F3D0" />
                                            </StackPanel>
                                        </Border>
                                        <!-- SOX 404 ITGC -->
                                        <Border Background="#3B0764" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#C084FC" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="SOX 404 ITGC" FontSize="10" FontWeight="Bold" Foreground="#E9D5FF" />
                                            </StackPanel>
                                        </Border>
                                        <!-- ISO 27001 -->
                                        <Border Background="#1C2738" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#38BDF8" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="ISO 27001:2022" FontSize="10" FontWeight="Bold" Foreground="#7DD3FC" />
                                            </StackPanel>
                                        </Border>
                                        <!-- NIST SP 800-53 -->
                                        <Border Background="#2B1D38" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#C084FC" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="NIST SP 800-53" FontSize="10" FontWeight="Bold" Foreground="#D8B4FE" />
                                            </StackPanel>
                                        </Border>
                                        <!-- CIS Benchmarks -->
                                        <Border Background="#2E2412" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FBBF24" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="CIS BENCHMARKS" FontSize="10" FontWeight="Bold" Foreground="#FDE68A" />
                                            </StackPanel>
                                        </Border>
                                        <!-- MeitY / STQC -->
                                        <Border Background="#1E2730" BorderBrush="#14B8A6" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#2DD4BF" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="MeitY / STQC" FontSize="10" FontWeight="Bold" Foreground="#5EEAD4" />
                                            </StackPanel>
                                        </Border>
                                        <!-- 100% Air-Gapped -->
                                        <Border Background="#1F1B2E" BorderBrush="#EC4899" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="#F472B6" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="100% AIR-GAPPED" FontSize="10" FontWeight="Bold" Foreground="#FBCFE8" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Score Cards Row -->
                        <Grid ColumnDefinitions="*, *, *, *, *, *" ColumnSpacing="12">
                            <!-- Health -->
                            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="SECURITY HEALTH" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtScoreHealth" Text="-- / 100" FontSize="26" FontWeight="ExtraBold" Foreground="#10B981" />
                                    <TextBlock Text="Overall Posture" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                            <!-- Threat -->
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="THREAT SCORE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtScoreThreat" Text="-- / 100" FontSize="26" FontWeight="ExtraBold" Foreground="#EF4444" />
                                    <TextBlock Text="Active Exposure" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                            <!-- Compliance -->
                            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="COMPLIANCE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtScoreCompliance" Text="-- %" FontSize="26" FontWeight="ExtraBold" Foreground="#38BDF8" />
                                    <TextBlock Text="CERT-In / ISO / CIS" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                            <!-- AI Risk -->
                            <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="AI RISK INDEX" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtScoreAiRisk" Text="-- %" FontSize="26" FontWeight="ExtraBold" Foreground="#F59E0B" />
                                    <TextBlock Text="Compromise Forecast" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                            <!-- Insider Threat -->
                            <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="INSIDER THREAT" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtScoreInsider" Text="-- %" FontSize="26" FontWeight="ExtraBold" Foreground="#A855F7" />
                                    <TextBlock Text="Data Leak Risk" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                            <!-- Ransomware -->
                            <Border Grid.Column="5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="RANSOMWARE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtScoreRansomware" Text="-- %" FontSize="26" FontWeight="ExtraBold" Foreground="#F43F5E" />
                                    <TextBlock Text="Propagation Risk" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Executive Summary Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Executive Audit Summary" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtExecutiveSummary" Text="Click 'Run Audit On-Demand' above to begin system inspection." TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                    <Border Background="#EF4444" CornerRadius="4" Padding="8,4"><TextBlock x:Name="BadgeCriticalCount" Text="0 Critical" FontSize="11" FontWeight="Bold" Foreground="White" /></Border>
                                    <Border Background="#F97316" CornerRadius="4" Padding="8,4"><TextBlock x:Name="BadgeHighCount" Text="0 High" FontSize="11" FontWeight="Bold" Foreground="White" /></Border>
                                    <Border Background="#F59E0B" CornerRadius="4" Padding="8,4"><TextBlock x:Name="BadgeMediumCount" Text="0 Medium" FontSize="11" FontWeight="Bold" Foreground="White" /></Border>
                                    <Border Background="#10B981" CornerRadius="4" Padding="8,4"><TextBlock x:Name="BadgeLowCount" Text="0 Low" FontSize="11" FontWeight="Bold" Foreground="White" /></Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- High Priority Findings List -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Top Priority Findings" FontSize="16" FontWeight="SemiBold" />
                                <ListView x:Name="ListDashboardTopFindings" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Border Background="#F97316" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding RemediationType}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- VIEW 2: ALL FINDINGS -->
                    <StackPanel x:Name="ViewFindings" Spacing="16" Visibility="Collapsed">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <TextBlock Text="All Audit Findings &amp; Discovered CVEs" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="TxtSearchFindings" PlaceholderText="Search findings, CVEs..." Width="220" TextChanged="TxtSearchFindings_TextChanged" />
                                <ComboBox x:Name="CmbSeverityFilter" Width="140" SelectedIndex="0" SelectionChanged="CmbSeverityFilter_SelectionChanged">
                                    <ComboBoxItem Content="All Severities" />
                                    <ComboBoxItem Content="Critical" />
                                    <ComboBoxItem Content="High" />
                                    <ComboBoxItem Content="Medium" />
                                    <ComboBoxItem Content="Low" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <ListView x:Name="ListAllFindings" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4">
                                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *, Auto" RowSpacing="6">
                                            <Border Grid.Row="0" Grid.Column="0" Background="#EF4444" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Category}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            
                                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Evidence, TargetNullValue=''}" FontSize="11" FontFamily="Consolas" Foreground="#38BDF8" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RemediationRecommendation}" FontSize="11" Foreground="#10B981" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Button Grid.Row="2" Grid.Column="2" Content="Remediate" Tag="{Binding Id}" Click="BtnFixSingle_Click" Visibility="{Binding CanAutoRemediate, Converter={StaticResource BoolToVisConverter}}" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- VIEW 3: 22 AUDIT MODULES -->
                    <StackPanel x:Name="ViewModules" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="22 Enterprise Audit Modules" FontSize="18" FontWeight="Bold" />
                        <ListView x:Name="ListModules" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4">
                                        <Grid ColumnDefinitions="*, Auto, Auto">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Key}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="Status: Audited &amp; Active" FontSize="11" Foreground="#10B981" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                                <TextBlock Text="{Binding Value, TargetNullValue='0'}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text=" ms" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="#10B981" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- VIEW 4: COMPLIANCE -->
                    <StackPanel x:Name="ViewCompliance" Spacing="16" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel>
                                <TextBlock Text="National &amp; International Compliance Scorecards" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Audit and benchmark host against Indian Sovereign, US Defense, US Financial, and Global Baselines" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Framework Profile:" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="CmbComplianceProfile" SelectedIndex="0" SelectionChanged="CmbComplianceProfile_SelectionChanged" MinWidth="260">
                                    <ComboBoxItem Content="🌐 All Frameworks (13 Standards)" />
                                    <ComboBoxItem Content="🇮🇳 Indian Sovereign (CERT-In, DPDP, MeitY, STQC)" />
                                    <ComboBoxItem Content="🛡️ US Defense &amp; Military (DISA STIG, CMMC, NIST 800-171)" />
                                    <ComboBoxItem Content="🏦 US Financial (PCI-DSS v4.0, SOX 404, GLBA)" />
                                    <ComboBoxItem Content="🏛️ Global Baselines (ISO 27001, CIS, NIST 800-53)" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <ListView x:Name="ListCompliance" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,6">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding StandardTitle}" FontWeight="Bold" FontSize="14" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding PassedControls}" FontSize="12" Foreground="#34D399" FontWeight="SemiBold" />
                                                    <TextBlock Text="/" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding TotalControls}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text=" Controls Compliant (" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding FailedControls}" FontSize="12" Foreground="#F87171" FontWeight="SemiBold" />
                                                    <TextBlock Text=" Non-Compliant)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ProgressBar Value="{Binding CompliancePercentage}" Maximum="100" Width="320" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CompliancePercentage}" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" />
                                                <TextBlock Text=" %" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Bottom" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- VIEW 5: DLP -->
                    <StackPanel x:Name="ViewDlp" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Data Protection &amp; Sensitive Information (DLP)" FontSize="18" FontWeight="Bold" />
                        <ListView x:Name="ListDlp" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <Border Background="#EF4444" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PatternType}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding RuleTriggered}" FontWeight="Bold" FontSize="13" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FilePath}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text=":" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding LineNumber}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding MaskedSnippet}" FontFamily="Consolas" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- VIEW 6: THREAT INTEL -->
                    <StackPanel x:Name="ViewThreats" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Correlated Multi-Stage Attack Chains" FontSize="18" FontWeight="Bold" />
                        <ListView x:Name="ListAttackChains" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,6">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#FCA5A5" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="Confidence: " FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding ConfidenceScore}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="%" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding RootCauseAnalysis}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="4" Padding="10">
                                                <TextBlock Text="{Binding SuggestedRemediation}" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- VIEW 7: REMEDIATION -->
                    <StackPanel x:Name="ViewRemediation" Spacing="16" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Automated One-Click &amp; Guided Remediation" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Content="Apply All Safe Fixes" Click="BtnRemediateAll_Click" />
                        </Grid>
                        <ListView x:Name="ListRemediation" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="{Binding RemediationRecommendation}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RemediationScript}" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Apply Fix" Tag="{Binding Id}" Click="BtnFixSingle_Click" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- VIEW 8: COPILOT -->
                    <StackPanel x:Name="ViewCopilot" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="AI Security Copilot (Local &amp; Offline Intelligence)" FontSize="18" FontWeight="Bold" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Height="400" Padding="16">
                            <ScrollViewer x:Name="CopilotScroll">
                                <TextBlock x:Name="TxtCopilotChatHistory" Text="Copilot: Ready to assist. Ask me about vulnerabilities, CERT-In status, or remediation recommendations." TextWrapping="Wrap" FontSize="13" LineHeight="20" />
                            </ScrollViewer>
                        </Border>
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <TextBox x:Name="TxtCopilotInput" PlaceholderText="Type a question (e.g. 'explain critical findings', 'cert-in status', 'remediation')..." KeyDown="TxtCopilotInput_KeyDown" />
                            <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Content="Ask Copilot" Click="BtnAskCopilot_Click" />
                        </Grid>
                    </StackPanel>

                    <!-- VIEW 9: EXPORTS -->
                    <StackPanel x:Name="ViewExports" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Export Official Audit Reports" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Generated reports are saved directly to the local application directory for archiving or submission." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                        <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12" Margin="0,12,0,0">
                            <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Padding="16" Click="BtnExportHtml_Click">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE774;" FontSize="24" Foreground="#38BDF8" />
                                    <TextBlock Text="Interactive HTML" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Padding="16" Click="BtnExportPdf_Click">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="24" Foreground="#EF4444" />
                                    <TextBlock Text="Executive PDF" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" Padding="16" Click="BtnExportExcel_Click">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="#10B981" />
                                    <TextBlock Text="Excel Workbook (.xls)" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Padding="16" Click="BtnExportCsv_Click">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="24" Foreground="#F59E0B" />
                                    <TextBlock Text="CSV Findings" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Padding="16" Click="BtnExportJson_Click">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE943;" FontSize="24" Foreground="#A855F7" />
                                    <TextBlock Text="JSON SOC Schema" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Padding="16" Click="BtnExportCertIn_Click">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE72D;" FontSize="24" Foreground="#F43F5E" />
                                    <TextBlock Text="CERT-In Annexure-I" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Page>
